<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- গ্রেডিয়েন্ট হেডার + সার্চ বক্স -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_header"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_box">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/navy_dark"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageView
                    android:id="@+id/imgSearchIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- সেকশন ১: Your own apps -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_your_apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerYourApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- সেকশন ২: All online apps -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_all_online" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAllOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- সেকশন ৩: Your own web app supported -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_web_supported" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWebSupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
