<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatingTools" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="android:statusBarColor">@color/navy_darker</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy_dark</item>
    </style>
</resources>
